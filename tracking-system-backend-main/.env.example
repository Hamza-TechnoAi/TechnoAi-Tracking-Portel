PORT=5050
# Local: mongodb://127.0.0.1:27017/technoai-tracking
# Render: use MongoDB Atlas URI and allow network access 0.0.0.0/0
MONGODB_CLOUD_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/technoai-tracking
JWT_SECRET=change-me-in-production

# Optional: Redis (OTP / forgot-password flows)
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_ENDPOINT=
REDIS_PORT=12821

# ── Email notifications (required to send alerts) ──
# Set to true after EMAIL + APP_PASSWORD are configured
EMAIL_NOTIFICATIONS_ENABLED=false

# Gmail account used to send emails (must match APP_PASSWORD account)
EMAIL=your-sender@gmail.com

# Gmail App Password (16 chars, no spaces/dashes — Google shows "abcd efgh ijkl mnop", use abcdefghijklmnop)
APP_PASSWORD=your-16-char-app-password

# Optional display/from override (defaults to EMAIL)
SMTP_FROM=TechnoAi Tracking <your-sender@gmail.com>

# Public tracking page URL (used in email "View shipment" links)
PUBLIC_TRACKING_URL=https://tracktechnoai.vercel.app

# Internal recipients
INTERNAL_EMAIL_TRACKING=tracking@technoai.ae
INTERNAL_EMAIL_PO_CLOSED=tracking@technoai.ae,info@technoai.ae,logistics@technoai.ae,tii@technoai.ae,accounts@technoai.ae

# Legacy flag (still supported if EMAIL_NOTIFICATIONS_ENABLED is not set)
LINE_STATUS_NOTIFICATIONS_ENABLED=false
NOTIFICATION_EMAIL_TO=tracking@technoai.ae

# Optional: Cloudinary (profile uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
